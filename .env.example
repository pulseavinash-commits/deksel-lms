# ============================================================
# Server-side secrets — set these in Netlify environment
# variables (Site settings → Environment variables).
# NONE of these are ever shipped to the browser. Do NOT prefix
# any secret with VITE_ (Vite would inline it into client JS).
# ============================================================

# Supabase (Project settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Random 64+ char string used to sign session cookies (JWT HS256)
SESSION_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# Gemini API key with Live API access (Google AI Studio)
GEMINI_API_KEY=YOUR-GEMINI-KEY

# Initial admin bootstrap (used once by /api/admin/bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# Initial learner access password (can be rotated in Admin → Settings)
LEARNER_ACCESS_PASSWORD=CHANGE-ME
